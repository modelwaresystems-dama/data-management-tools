{
  "id": "cdmp-value-corporate-v1",
  "title": "The Value of CDMP to Employers",
  "purpose": "To understand what value employers — data leaders, knowledge-area practice managers, and learning & development teams — attribute to the CDMP qualification, and how they treat it in hiring, sponsorship and professional development.",
  "estimatedMinutes": "8–10",
  "engineVersion": 1,
  "config": {
    "endpoint": "https://cdmp-survey-proxy.howard-217.workers.dev/",
    "endpointComment": "LIVE: posts each response to the shared Worker. Set to \"\" to return to preview mode (compiles and shows the response JSON, posts nothing).",
    "turnstileSiteKey": "0x4AAAAAAFJ-Rw3U5NbdpEAa",
    "turnstileComment": "LIVE Turnstile SITE key (public, safe here). Same Pages hostname as the barriers survey; the Worker holds the matching TURNSTILE_SECRET. Set to \"\" to drop the human-check widget.",
    "collectEmail": true,
    "emailOptional": true,
    "lockAfterSubmit": true,
    "softDedupe": true
  },
  "sections": [
    {
      "id": "s1",
      "title": "About your organisation",
      "questions": [
        {
          "id": "q_role",
          "type": "single",
          "required": true,
          "text": "Which best describes your role?",
          "help": "This tailors a few later questions to your vantage point.",
          "options": [
            {
              "v": "cdo",
              "label": "CDO or Head of Data / Data Management"
            },
            {
              "v": "kapm",
              "label": "Knowledge-Area Practice Manager (e.g. BI, Data Quality, Governance, Architecture)"
            },
            {
              "v": "ld",
              "label": "Learning & Development / HR"
            },
            {
              "v": "other",
              "label": "Other data-leadership role"
            }
          ]
        },
        {
          "id": "q_sector",
          "type": "single",
          "required": true,
          "text": "What is your organisation's primary sector?",
          "options": [
            {
              "v": "financial",
              "label": "Financial services / Insurance"
            },
            {
              "v": "public",
              "label": "Public sector / Government"
            },
            {
              "v": "health",
              "label": "Healthcare / Pharma"
            },
            {
              "v": "retail",
              "label": "Retail / Consumer"
            },
            {
              "v": "tech",
              "label": "Technology / Software"
            },
            {
              "v": "telco",
              "label": "Telecoms"
            },
            {
              "v": "energy",
              "label": "Energy / Utilities / Mining"
            },
            {
              "v": "proservices",
              "label": "Professional / Consulting services"
            },
            {
              "v": "education",
              "label": "Education"
            },
            {
              "v": "other",
              "label": "Other"
            }
          ]
        },
        {
          "id": "q_orgsize",
          "type": "single",
          "required": true,
          "text": "Roughly how large is your organisation?",
          "options": [
            {
              "v": "xs",
              "label": "Fewer than 50 people"
            },
            {
              "v": "s",
              "label": "50–250"
            },
            {
              "v": "m",
              "label": "251–1,000"
            },
            {
              "v": "l",
              "label": "1,001–5,000"
            },
            {
              "v": "xl",
              "label": "More than 5,000"
            }
          ]
        },
        {
          "id": "q_region",
          "type": "single",
          "required": true,
          "text": "Where is your organisation primarily based?",
          "options": [
            {
              "v": "africa",
              "label": "Africa"
            },
            {
              "v": "europe",
              "label": "Europe / UK"
            },
            {
              "v": "namerica",
              "label": "North America"
            },
            {
              "v": "latam",
              "label": "Latin America"
            },
            {
              "v": "mena",
              "label": "Middle East"
            },
            {
              "v": "apac",
              "label": "Asia-Pacific"
            },
            {
              "v": "other",
              "label": "Other"
            }
          ]
        },
        {
          "id": "q_familiarity",
          "type": "likert",
          "required": true,
          "text": "How familiar is your organisation with the CDMP certification?",
          "min": 1,
          "max": 5,
          "minLabel": "Not familiar at all",
          "maxLabel": "Very familiar"
        }
      ]
    },
    {
      "id": "s2",
      "title": "The value you place on CDMP",
      "questions": [
        {
          "id": "q_value_battery",
          "type": "matrix",
          "required": true,
          "text": "How much do you agree that CDMP certification does each of the following for your organisation?",
          "min": 1,
          "max": 5,
          "scaleLabels": [
            "Strongly disagree",
            "",
            "",
            "",
            "Strongly agree"
          ],
          "rows": [
            {
              "k": "signals_competence",
              "label": "Signals genuine data-management competence"
            },
            {
              "k": "hiring_screen",
              "label": "Is a useful screen when hiring for data roles"
            },
            {
              "k": "reduces_risk",
              "label": "Reduces delivery, governance or compliance risk"
            },
            {
              "k": "common_language",
              "label": "Gives our teams a common professional vocabulary"
            },
            {
              "k": "vendor_neutral",
              "label": "Provides vendor-neutral knowledge that outlasts tools"
            },
            {
              "k": "team_capability",
              "label": "Raises overall team capability"
            },
            {
              "k": "client_credibility",
              "label": "Strengthens credibility with our clients or stakeholders"
            },
            {
              "k": "worth_sponsoring",
              "label": "Is worth the organisation sponsoring"
            }
          ]
        },
        {
          "id": "q_hiring_influence",
          "type": "likert",
          "required": true,
          "text": "When hiring for a data role, how much does a candidate holding CDMP influence your decision?",
          "min": 1,
          "max": 6,
          "minLabel": "No influence",
          "maxLabel": "Decisive",
          "extraLabels": {
            "6": "We don't hire for data roles"
          }
        },
        {
          "id": "q_recommend",
          "type": "single",
          "required": true,
          "text": "Would you encourage your data staff to pursue CDMP?",
          "options": [
            {
              "v": "A",
              "label": "Yes — we actively encourage it"
            },
            {
              "v": "B",
              "label": "Yes — if they raise it"
            },
            {
              "v": "C",
              "label": "Neutral / no position"
            },
            {
              "v": "D",
              "label": "No — we don't see the value"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        },
        {
          "id": "q_vendor_disconnect",
          "type": "single",
          "required": true,
          "text": "CDMP is deliberately vendor-neutral — it doesn't validate specific tools (e.g. dbt, Databricks, Microsoft Fabric). For your organisation, is that:",
          "options": [
            {
              "v": "A",
              "label": "A real limitation — we also need tool-specific proof"
            },
            {
              "v": "B",
              "label": "A minor limitation"
            },
            {
              "v": "C",
              "label": "Neither an advantage nor a limitation"
            },
            {
              "v": "D",
              "label": "An advantage — tool-independent knowledge lasts longer"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        },
        {
          "id": "q_comp_recognition",
          "type": "single",
          "required": true,
          "text": "Does holding CDMP influence pay or grade in your organisation?",
          "options": [
            {
              "v": "A",
              "label": "Yes — it meaningfully affects pay or grade"
            },
            {
              "v": "B",
              "label": "A minor factor"
            },
            {
              "v": "C",
              "label": "No influence on pay"
            },
            {
              "v": "D",
              "label": "We don't link certifications to pay"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        },
        {
          "id": "q_pmp_weight",
          "type": "single",
          "required": true,
          "text": "Do you weigh CDMP the way you'd weigh PMP — a serious professional credential for its discipline?",
          "options": [
            {
              "v": "A",
              "label": "Yes — comparable weight"
            },
            {
              "v": "B",
              "label": "Somewhat"
            },
            {
              "v": "C",
              "label": "Less than PMP"
            },
            {
              "v": "D",
              "label": "We don't use PMP as a benchmark either"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "title": "The CDMP levels",
      "intro": "CDMP has three progressive levels: Associate (foundational knowledge), Practitioner (breadth plus two specialist areas), and Master (higher scores plus substantial experience).",
      "questions": [
        {
          "id": "q_levels_known",
          "type": "likert",
          "required": true,
          "text": "How well does your organisation understand the difference between CDMP Associate, Practitioner and Master?",
          "min": 1,
          "max": 6,
          "minLabel": "Not at all",
          "maxLabel": "Very well",
          "extraLabels": {
            "6": "Don't know"
          }
        },
        {
          "id": "q_level_distinguish",
          "type": "single",
          "required": true,
          "text": "In hiring or promotion, how does your organisation treat the CDMP level?",
          "options": [
            {
              "v": "A",
              "label": "We specify or require a particular level"
            },
            {
              "v": "B",
              "label": "We note the level but don't require one"
            },
            {
              "v": "C",
              "label": "We treat 'CDMP' as one thing, regardless of level"
            },
            {
              "v": "D",
              "label": "We don't track CDMP level at all"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        },
        {
          "id": "q_sponsor_levels",
          "type": "matrix",
          "required": true,
          "text": "How likely is your organisation to fund an employee progressing to each level?",
          "min": 1,
          "max": 5,
          "scaleLabels": [
            "Very unlikely",
            "",
            "",
            "",
            "Very likely"
          ],
          "rows": [
            {
              "k": "associate",
              "label": "Associate (the DMF exam)"
            },
            {
              "k": "practitioner",
              "label": "Practitioner (two further specialist exams)"
            },
            {
              "k": "master",
              "label": "Master (higher scores + experience review)"
            }
          ]
        },
        {
          "id": "q_progression_value",
          "type": "single",
          "required": true,
          "text": "Which best reflects the value your organisation places on progression beyond Associate?",
          "options": [
            {
              "v": "A",
              "label": "Practitioner / Master are clearly more valuable to us"
            },
            {
              "v": "B",
              "label": "Somewhat more valuable"
            },
            {
              "v": "C",
              "label": "No real difference to us"
            },
            {
              "v": "D",
              "label": "It depends entirely on the role"
            },
            {
              "v": "E",
              "label": "Don't know"
            }
          ]
        },
        {
          "id": "q_evidence_expected",
          "type": "multi",
          "required": true,
          "text": "Beyond passing the exam, what evidence would make a CDMP level credible to you as an employer?",
          "help": "Select up to three.",
          "max": 3,
          "options": [
            {
              "v": "portfolio",
              "label": "A professional portfolio of work"
            },
            {
              "v": "project",
              "label": "A workplace project or case study"
            },
            {
              "v": "references",
              "label": "Employer / client references"
            },
            {
              "v": "interview",
              "label": "A structured professional interview"
            },
            {
              "v": "peer",
              "label": "Peer or mentor assessment"
            },
            {
              "v": "experience",
              "label": "Verified years of relevant experience"
            },
            {
              "v": "scores",
              "label": "Higher examination scores"
            },
            {
              "v": "contribution",
              "label": "Contribution to the data profession"
            },
            {
              "v": "none",
              "label": "The exam alone is enough",
              "exclusive": true
            },
            {
              "v": "other",
              "label": "Other"
            }
          ]
        }
      ]
    },
    {
      "id": "s4",
      "title": "From your vantage point",
      "questions": [
        {
          "id": "q_cdo_framework",
          "type": "single",
          "required": true,
          "text": "Is CDMP part of your data team's capability or career framework?",
          "showIf": {
            "question": "q_role",
            "in": [
              "cdo"
            ]
          },
          "options": [
            {
              "v": "A",
              "label": "Yes — formally"
            },
            {
              "v": "B",
              "label": "Yes — informally"
            },
            {
              "v": "C",
              "label": "No, but we are planning to"
            },
            {
              "v": "D",
              "label": "No"
            }
          ]
        },
        {
          "id": "q_cdo_budget",
          "type": "single",
          "required": true,
          "text": "Does your current budget fund CDMP exams or training?",
          "showIf": {
            "question": "q_role",
            "in": [
              "cdo"
            ]
          },
          "options": [
            {
              "v": "A",
              "label": "Yes — fully"
            },
            {
              "v": "B",
              "label": "Yes — partially"
            },
            {
              "v": "C",
              "label": "Case by case"
            },
            {
              "v": "D",
              "label": "No"
            }
          ]
        },
        {
          "id": "q_kapm_competence",
          "type": "likert",
          "required": true,
          "text": "How well does CDMP reflect the on-the-job competence you actually need in your area?",
          "showIf": {
            "question": "q_role",
            "in": [
              "kapm"
            ]
          },
          "min": 1,
          "max": 5,
          "minLabel": "Not at all",
          "maxLabel": "Very well"
        },
        {
          "id": "q_kapm_specialist",
          "type": "multi",
          "required": true,
          "text": "Which CDMP specialist areas matter most for your team?",
          "help": "Select up to three.",
          "showIf": {
            "question": "q_role",
            "in": [
              "kapm"
            ]
          },
          "max": 3,
          "options": [
            {
              "v": "governance",
              "label": "Data Governance"
            },
            {
              "v": "quality",
              "label": "Data Quality"
            },
            {
              "v": "metadata",
              "label": "Metadata"
            },
            {
              "v": "modeling",
              "label": "Data Modeling and Design"
            },
            {
              "v": "integration",
              "label": "Data Integration and Interoperability"
            },
            {
              "v": "dwbi",
              "label": "Data Warehousing & Business Intelligence"
            },
            {
              "v": "mdm",
              "label": "Reference and Master Data Management"
            }
          ]
        },
        {
          "id": "q_ld_recognised",
          "type": "single",
          "required": true,
          "text": "Is CDMP recognised in your learning & development catalogue or professional-development framework?",
          "showIf": {
            "question": "q_role",
            "in": [
              "ld"
            ]
          },
          "options": [
            {
              "v": "A",
              "label": "Yes — listed and supported"
            },
            {
              "v": "B",
              "label": "Recognised informally"
            },
            {
              "v": "C",
              "label": "No, but under consideration"
            },
            {
              "v": "D",
              "label": "No"
            }
          ]
        },
        {
          "id": "q_ld_policy",
          "type": "single",
          "required": true,
          "text": "What is your organisation's sponsorship policy for professional certifications like CDMP?",
          "showIf": {
            "question": "q_role",
            "in": [
              "ld"
            ]
          },
          "options": [
            {
              "v": "A",
              "label": "Pay fees upfront"
            },
            {
              "v": "B",
              "label": "Reimburse on a pass"
            },
            {
              "v": "C",
              "label": "Study leave / time only"
            },
            {
              "v": "D",
              "label": "Varies case by case"
            },
            {
              "v": "E",
              "label": "No support"
            }
          ]
        },
        {
          "id": "q_other_note",
          "type": "text",
          "required": false,
          "long": false,
          "text": "In a sentence, how does your role relate to CDMP in your organisation?",
          "showIf": {
            "question": "q_role",
            "in": [
              "other"
            ]
          }
        }
      ]
    },
    {
      "id": "s5",
      "title": "What would change your decision",
      "questions": [
        {
          "id": "q_barrier_sponsor",
          "type": "single",
          "required": true,
          "text": "What most limits your organisation sponsoring CDMP or its progression?",
          "options": [
            {
              "v": "A",
              "label": "Cost of exams and training"
            },
            {
              "v": "B",
              "label": "Unclear return on investment"
            },
            {
              "v": "C",
              "label": "The market doesn't distinguish the levels"
            },
            {
              "v": "D",
              "label": "Time away from work to study"
            },
            {
              "v": "E",
              "label": "Lack of local or in-house training"
            },
            {
              "v": "F",
              "label": "We already sponsor it fully"
            },
            {
              "v": "G",
              "label": "Other"
            }
          ]
        },
        {
          "id": "q_what_persuades",
          "type": "multi",
          "required": true,
          "text": "What evidence would most increase CDMP's value to your organisation?",
          "help": "Select up to three.",
          "max": 3,
          "options": [
            {
              "v": "competence",
              "label": "Proof of real workplace competence (portfolio, projects)"
            },
            {
              "v": "hiring",
              "label": "Evidence of hiring or retention benefit"
            },
            {
              "v": "salary",
              "label": "Salary / market-value data"
            },
            {
              "v": "cases",
              "label": "Employer case studies"
            },
            {
              "v": "leveldiff",
              "label": "Clear differentiation between the levels"
            },
            {
              "v": "localsupport",
              "label": "Local cohort or in-house training support"
            },
            {
              "v": "roleframeworks",
              "label": "Mapping of CDMP to our role frameworks"
            },
            {
              "v": "other",
              "label": "Other"
            }
          ]
        }
      ]
    },
    {
      "id": "s6",
      "title": "In your own words",
      "questions": [
        {
          "id": "q_open_value",
          "type": "text",
          "required": false,
          "long": true,
          "text": "In your own words, what value — if any — does CDMP certification bring to your organisation?"
        },
        {
          "id": "q_open_improve",
          "type": "text",
          "required": false,
          "long": true,
          "text": "What would make CDMP more valuable to employers like you?"
        }
      ]
    }
  ],
  "analysis": {
    "segmentation": {
      "field": "segment",
      "otherLabel": "Other role",
      "compare": {
        "a": "role_cdo",
        "b": "role_ld"
      },
      "rules": [
        {
          "segment": "role_cdo",
          "label": "CDO / Head of Data",
          "when": {
            "q_role": [
              "cdo"
            ]
          }
        },
        {
          "segment": "role_kapm",
          "label": "Practice Manager",
          "when": {
            "q_role": [
              "kapm"
            ]
          }
        },
        {
          "segment": "role_ld",
          "label": "L&D / HR",
          "when": {
            "q_role": [
              "ld"
            ]
          }
        },
        {
          "segment": "role_other",
          "label": "Other role",
          "when": {
            "q_role": [
              "other"
            ]
          }
        }
      ]
    },
    "scaleMax": 5,
    "indices": [
      {
        "id": "hiring_value",
        "label": "Hiring / competence signal",
        "dir": "positive",
        "items": [
          {
            "f": "q_value_battery.signals_competence"
          },
          {
            "f": "q_value_battery.hiring_screen"
          },
          {
            "f": "q_hiring_influence",
            "exclude": [
              6
            ]
          }
        ]
      },
      {
        "id": "capability_value",
        "label": "Capability & risk value",
        "dir": "positive",
        "items": [
          {
            "f": "q_value_battery.team_capability"
          },
          {
            "f": "q_value_battery.common_language"
          },
          {
            "f": "q_value_battery.reduces_risk"
          },
          {
            "f": "q_value_battery.vendor_neutral"
          },
          {
            "f": "q_value_battery.client_credibility"
          }
        ]
      },
      {
        "id": "sponsorship_value",
        "label": "Willingness to sponsor",
        "dir": "positive",
        "items": [
          {
            "f": "q_value_battery.worth_sponsoring"
          },
          {
            "f": "q_sponsor_levels.practitioner"
          },
          {
            "f": "q_sponsor_levels.master"
          }
        ]
      },
      {
        "id": "level_recognition",
        "label": "Level recognition",
        "dir": "positive",
        "items": [
          {
            "f": "q_levels_known",
            "exclude": [
              6
            ]
          }
        ]
      }
    ],
    "distributions": [
      "q_recommend",
      "q_level_distinguish",
      "q_progression_value",
      "q_evidence_expected",
      "q_barrier_sponsor",
      "q_what_persuades",
      "q_vendor_disconnect",
      "q_comp_recognition",
      "q_pmp_weight"
    ]
  }
}
