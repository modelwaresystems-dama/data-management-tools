    "endpoint": "https://cdmp-survey-proxy.howard-217.workers.dev/",
    "endpointComment": "Set this to your serverless write-proxy URL once deployed. Leave blank to run in preview mode (compiles the response and shows it instead of posting).",
    "turnstileSiteKey": "",
    "turnstileComment": "Cloudflare Turnstile SITE key (public — safe in this file). When set, the form shows the verification and sends its token; the Worker must hold the matching TURNSTILE_SECRET. Blank disables it.",
    "collectEmail": true,
    "emailOptional": true,
    "lockAfterSubmit": true,
    "lockComment": "true = one submission per browser: after a completed send this browser sees an already-completed screen (clearing site data bypasses it).",
